{
  "$defs": {
    "AgentExecutionPlanLLMResponse": {
      "additionalProperties": false,
      "description": "Only high-level planner suggestions; no execution or approval fields.",
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "limits": {
          "additionalProperties": true,
          "title": "Limits",
          "type": "object"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/AgentExecutionPlanQuestion"
          },
          "title": "Questions",
          "type": "array"
        },
        "rationales": {
          "items": {
            "type": "string"
          },
          "title": "Rationales",
          "type": "array"
        },
        "requested_tool_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requested Tool Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "agent_execution_plan_llm_response.v1",
          "default": "agent_execution_plan_llm_response.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_input_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Input Artifact Ids",
          "type": "array"
        },
        "selected_logical_profile_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Logical Profile Ids",
          "type": "array"
        },
        "stop_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Stop Conditions",
          "type": "array"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Success Criteria",
          "type": "array"
        },
        "task_options": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Task Options",
          "type": "object"
        }
      },
      "required": [
        "requested_tool_ids",
        "selected_input_artifact_ids",
        "task_options",
        "selected_logical_profile_ids",
        "limits",
        "stop_conditions",
        "success_criteria",
        "rationales",
        "assumptions",
        "questions"
      ],
      "title": "AgentExecutionPlanLLMResponse",
      "type": "object"
    },
    "AgentExecutionPlanQuestion": {
      "additionalProperties": false,
      "properties": {
        "blocks_proposal": {
          "default": true,
          "title": "Blocks Proposal",
          "type": "boolean"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "prompt",
        "reason"
      ],
      "title": "AgentExecutionPlanQuestion",
      "type": "object"
    },
    "AgentLLMInvocationMetadata": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "observation_digest": {
          "title": "Observation Digest",
          "type": "string"
        },
        "prompt_version": {
          "const": "scientific-agent-long-horizon-plan.v1",
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "response_id": {
          "default": "",
          "title": "Response Id",
          "type": "string"
        },
        "tool_catalog_digest": {
          "title": "Tool Catalog Digest",
          "type": "string"
        },
        "validated_output_digest": {
          "title": "Validated Output Digest",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "prompt_version",
        "observation_digest",
        "tool_catalog_digest",
        "validated_output_digest"
      ],
      "title": "AgentLLMInvocationMetadata",
      "type": "object"
    },
    "AgentRemoteResourceRequestIntent": {
      "additionalProperties": false,
      "description": "Review-only resource intent; nullable fields are never invented authority.",
      "properties": {
        "cpu_threads": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Threads"
        },
        "gpu_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Count"
        },
        "status": {
          "default": "not_configured",
          "enum": [
            "not_configured",
            "partial",
            "configured"
          ],
          "title": "Status",
          "type": "string"
        },
        "walltime_sec": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walltime Sec"
        }
      },
      "title": "AgentRemoteResourceRequestIntent",
      "type": "object"
    },
    "AgentTaskDispatchIntent": {
      "additionalProperties": false,
      "description": "Non-executing route binding for one canonical RunPlan task.",
      "properties": {
        "execution_route": {
          "enum": [
            "local_executor",
            "remote_execution_service"
          ],
          "title": "Execution Route",
          "type": "string"
        },
        "logical_profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Profile Id"
        },
        "remote_task_type": {
          "anyOf": [
            {
              "enum": [
                "document_parsing",
                "model_inference",
                "model_training",
                "molecular_generation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Task Type"
        },
        "requested_resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRemoteResourceRequestIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "execution_route"
      ],
      "title": "AgentTaskDispatchIntent",
      "type": "object"
    },
    "PlannedTask": {
      "properties": {
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "output_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "required_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Required Artifacts",
          "type": "array"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "unresolved_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Requirements",
          "type": "array"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "PlannedTask",
      "type": "object"
    },
    "RunPlan": {
      "properties": {
        "available_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Available Artifacts",
          "type": "array"
        },
        "missing_artifacts": {
          "items": {
            "type": "string"
          },
          "title": "Missing Artifacts",
          "type": "array"
        },
        "requested_tasks": {
          "items": {
            "type": "string"
          },
          "title": "Requested Tasks",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/PlannedTask"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "requested_tasks",
        "tasks"
      ],
      "title": "RunPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable review/control artifact.  It is never an execution authority.",
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "authorization_scope_digest": {
      "default": "",
      "title": "Authorization Scope Digest",
      "type": "string"
    },
    "client_request_id": {
      "title": "Client Request Id",
      "type": "string"
    },
    "compiled_task_options": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Compiled Task Options",
      "type": "object"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "dispatch_intents": {
      "items": {
        "$ref": "#/$defs/AgentTaskDispatchIntent"
      },
      "title": "Dispatch Intents",
      "type": "array"
    },
    "effective_planner_options": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Effective Planner Options",
      "type": "object"
    },
    "executable": {
      "const": false,
      "default": false,
      "title": "Executable",
      "type": "boolean"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "invocation_id": {
      "title": "Invocation Id",
      "type": "string"
    },
    "limits": {
      "additionalProperties": true,
      "title": "Limits",
      "type": "object"
    },
    "llm_invocation": {
      "$ref": "#/$defs/AgentLLMInvocationMetadata"
    },
    "missing_artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Missing Artifacts",
      "type": "array"
    },
    "observation_digest": {
      "title": "Observation Digest",
      "type": "string"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "option_compiler_version": {
      "const": "scientific-planner-option-compiler.v1",
      "default": "scientific-planner-option-compiler.v1",
      "title": "Option Compiler Version",
      "type": "string"
    },
    "planner_backend": {
      "title": "Planner Backend",
      "type": "string"
    },
    "planner_options": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Planner Options",
      "type": "object"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "prompt_version": {
      "const": "scientific-agent-long-horizon-plan.v1",
      "title": "Prompt Version",
      "type": "string"
    },
    "proposal_digest": {
      "default": "",
      "title": "Proposal Digest",
      "type": "string"
    },
    "proposal_id": {
      "default": "",
      "title": "Proposal Id",
      "type": "string"
    },
    "publication_id": {
      "default": "",
      "title": "Publication Id",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/AgentExecutionPlanQuestion"
      },
      "title": "Questions",
      "type": "array"
    },
    "rationales": {
      "items": {
        "type": "string"
      },
      "title": "Rationales",
      "type": "array"
    },
    "required_gates": {
      "items": {
        "type": "string"
      },
      "title": "Required Gates",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_plan": {
      "$ref": "#/$defs/RunPlan"
    },
    "schema_version": {
      "const": "agent_execution_plan_proposal.v1",
      "default": "agent_execution_plan_proposal.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Selected Artifacts",
      "type": "array"
    },
    "selected_profiles": {
      "items": {
        "type": "string"
      },
      "title": "Selected Profiles",
      "type": "array"
    },
    "semantic_plan_digest": {
      "default": "",
      "title": "Semantic Plan Digest",
      "type": "string"
    },
    "semantic_plan_id": {
      "default": "",
      "title": "Semantic Plan Id",
      "type": "string"
    },
    "status": {
      "const": "review_required",
      "default": "review_required",
      "title": "Status",
      "type": "string"
    },
    "stop_conditions": {
      "items": {
        "type": "string"
      },
      "title": "Stop Conditions",
      "type": "array"
    },
    "success_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Success Criteria",
      "type": "array"
    },
    "tool_catalog_digest": {
      "title": "Tool Catalog Digest",
      "type": "string"
    },
    "user_constraints": {
      "items": {
        "type": "string"
      },
      "title": "User Constraints",
      "type": "array"
    },
    "validated_llm_response": {
      "$ref": "#/$defs/AgentExecutionPlanLLMResponse"
    }
  },
  "required": [
    "project_id",
    "run_id",
    "goal",
    "planner_backend",
    "prompt_version",
    "observation_id",
    "observation_digest",
    "tool_catalog_digest",
    "validated_llm_response",
    "run_plan",
    "llm_invocation",
    "invocation_id",
    "client_request_id",
    "created_at"
  ],
  "title": "AgentExecutionPlanProposal",
  "type": "object"
}
