{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molly.local/schemas/source_dataset_manifest.schema.json",
  "title": "Source Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "materialization_binding": ["materialization_binding_digest"],
    "materialization_binding_digest": ["materialization_binding"]
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "materialization_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "source_artifact_id", "source_kind",
        "raw_dataset_digest", "input_row_count", "column_roster",
        "mapping_policy_digest", "mapping_policy_version",
        "publication_identity", "canonicalization_contract_version",
        "provider_name", "expected_provider_version", "execution_profile_id",
        "execution_profile_digest", "repository_commit",
        "worker_implementation_digest"
      ],
      "properties": {
        "schema_version": {"const": "br1_source_manifest_materialization.v1"},
        "source_artifact_id": {"const": "raw_dataset"},
        "source_kind": {"const": "private"},
        "raw_dataset_digest": {"$ref": "#/$defs/digest"},
        "input_row_count": {"type": "integer", "minimum": 1},
        "column_roster": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mapping_policy_digest": {"$ref": "#/$defs/digest"},
        "mapping_policy_version": {"const": "br1_raw_dataset_mapping_policy.v1"},
        "publication_identity": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"},
        "canonicalization_contract_version": {"const": "br1_provider_input_canonicalization.v1"},
        "provider_name": {"const": "unimol-tools"},
        "expected_provider_version": {"type": "string", "minLength": 1},
        "execution_profile_id": {"const": "unimol-train-br1-v2"},
        "execution_profile_digest": {"$ref": "#/$defs/digest"},
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "worker_implementation_digest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "required": [
    "schema_version", "dataset_name", "dataset_version", "dataset_doi",
    "license", "download_date", "original_file_sha256",
    "derived_raw_dataset_sha256"
  ],
  "properties": {
    "schema_version": {"const": "source_dataset_manifest.v1"},
    "dataset_name": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "dataset_doi": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "download_date": {"type": "string", "format": "date"},
    "original_file_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "derived_raw_dataset_sha256": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "materialization_binding": {"$ref": "#/$defs/materialization_binding"},
    "materialization_binding_digest": {"$ref": "#/$defs/digest"}
  }
}
