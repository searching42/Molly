{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molly.local/schemas/br1_preflight_source_authority.schema.json",
  "title": "BR1 Applicability Preflight Source Authority v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mapping_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mapping_policy_schema_version",
        "source_schema_version",
        "provider_name",
        "expected_provider_version",
        "execution_profile_id",
        "molecule_representation_field",
        "target_field",
        "row_identity_field",
        "condition_context_fields",
        "required_source_columns",
        "missing_value_policy",
        "filter_policy",
        "duplicate_row_policy",
        "canonical_row_order",
        "output_columns"
      ],
      "properties": {
        "schema_version": {"const": "br1_preflight_mapping_binding.v1"},
        "mapping_policy_schema_version": {"const": "br1_raw_dataset_mapping_policy.v1"},
        "source_schema_version": {"const": "structured_raw_dataset.v1"},
        "provider_name": {"const": "unimol-tools"},
        "expected_provider_version": {"type": "string", "minLength": 1},
        "execution_profile_id": {"const": "unimol-train-br1-v2"},
        "molecule_representation_field": {"const": "smiles"},
        "target_field": {"const": "target_value"},
        "row_identity_field": {"const": "row_id"},
        "condition_context_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_source_columns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "missing_value_policy": {"const": "reject"},
        "filter_policy": {"const": "no_implicit_filter"},
        "duplicate_row_policy": {"const": "reject_duplicate_standard_inchikey"},
        "canonical_row_order": {"const": "row_id_ascending"},
        "output_columns": {"const": ["smiles", "target_value"]}
      }
    }
  },
  "required": [
    "schema_version",
    "authority_contract_version",
    "source_artifact_id",
    "source_publication_registry_id",
    "source_publication_registry_digest",
    "source_publication_digest",
    "source_dataset_manifest_digest",
    "mapping_policy_digest",
    "mapping_policy_version",
    "mapping_binding",
    "mapping_binding_digest",
    "raw_dataset_digest",
    "canonical_source_dataset_digest",
    "canonical_provider_input_digest",
    "input_row_count",
    "canonicalization_contract_version",
    "provider_name",
    "expected_provider_version",
    "execution_profile_id",
    "execution_profile_digest",
    "authority_digest"
  ],
  "properties": {
    "schema_version": {"const": "br1_preflight_source_authority.v1"},
    "authority_contract_version": {"const": "br1_preflight_source_authority.v1"},
    "source_artifact_id": {"const": "raw_dataset"},
    "source_publication_registry_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"},
    "source_publication_registry_digest": {"$ref": "#/$defs/digest"},
    "source_publication_digest": {"$ref": "#/$defs/digest"},
    "source_dataset_manifest_digest": {"$ref": "#/$defs/digest"},
    "mapping_policy_digest": {"$ref": "#/$defs/digest"},
    "mapping_policy_version": {"const": "br1_raw_dataset_mapping_policy.v1"},
    "mapping_binding": {"$ref": "#/$defs/mapping_binding"},
    "mapping_binding_digest": {"$ref": "#/$defs/digest"},
    "raw_dataset_digest": {"$ref": "#/$defs/digest"},
    "canonical_source_dataset_digest": {"$ref": "#/$defs/digest"},
    "canonical_provider_input_digest": {"$ref": "#/$defs/digest"},
    "input_row_count": {"type": "integer", "minimum": 1},
    "canonicalization_contract_version": {"const": "br1_provider_input_canonicalization.v1"},
    "provider_name": {"const": "unimol-tools"},
    "expected_provider_version": {"type": "string", "minLength": 1},
    "execution_profile_id": {"const": "unimol-train-br1-v2"},
    "execution_profile_digest": {"$ref": "#/$defs/digest"},
    "authority_digest": {"$ref": "#/$defs/digest"}
  }
}
