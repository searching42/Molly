{
  "$defs": {
    "AgentHarnessAuthorityClass": {
      "enum": [
        "authoritative",
        "derived",
        "observational",
        "unverified"
      ],
      "title": "AgentHarnessAuthorityClass",
      "type": "string"
    },
    "AgentHarnessControllerAction": {
      "enum": [
        "prepare_local_gate",
        "wait_for_gate",
        "stop_gate_rejected",
        "execute_local_task",
        "prepare_remote_request",
        "wait_for_remote_approval",
        "stop_remote_rejected",
        "dispatch_remote_task",
        "refresh_remote_task",
        "recover_remote_task",
        "adopt_remote_outputs",
        "stop_task_terminal",
        "cancel_execution",
        "complete_execution"
      ],
      "title": "AgentHarnessControllerAction",
      "type": "string"
    },
    "AgentHarnessControllerReceiptOutcome": {
      "enum": [
        "committed",
        "reconciled",
        "waiting",
        "rejected",
        "failed",
        "conflict"
      ],
      "title": "AgentHarnessControllerReceiptOutcome",
      "type": "string"
    },
    "AgentHarnessControllerSourceBinding": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "authority_class": {
          "$ref": "#/$defs/AgentHarnessAuthorityClass",
          "default": "authoritative"
        }
      },
      "required": [
        "name",
        "source_id",
        "source_digest"
      ],
      "title": "AgentHarnessControllerSourceBinding",
      "type": "object"
    },
    "AgentHarnessControllerStatus": {
      "enum": [
        "active",
        "waiting_gate",
        "waiting_remote_approval",
        "running_remote",
        "recovery_required",
        "cancelled",
        "failed",
        "succeeded"
      ],
      "title": "AgentHarnessControllerStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable exact-read result for one selected Controller action.",
  "properties": {
    "schema_version": {
      "const": "agent_harness_controller_action_receipt.v1",
      "default": "agent_harness_controller_action_receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "default": "",
      "title": "Receipt Id",
      "type": "string"
    },
    "controller_execution_id": {
      "title": "Controller Execution Id",
      "type": "string"
    },
    "controller_execution_digest": {
      "title": "Controller Execution Digest",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "decision_digest": {
      "title": "Decision Digest",
      "type": "string"
    },
    "action_kind": {
      "$ref": "#/$defs/AgentHarnessControllerAction"
    },
    "task_id": {
      "default": "",
      "title": "Task Id",
      "type": "string"
    },
    "task_index": {
      "anyOf": [
        {
          "maximum": 1023,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Index"
    },
    "attempt_ordinal": {
      "default": 0,
      "maximum": 1023,
      "minimum": 0,
      "title": "Attempt Ordinal",
      "type": "integer"
    },
    "slot_id": {
      "default": "",
      "title": "Slot Id",
      "type": "string"
    },
    "execution_started": {
      "title": "Execution Started",
      "type": "boolean"
    },
    "dispatch_occurred": {
      "title": "Dispatch Occurred",
      "type": "boolean"
    },
    "before_stage_digest": {
      "default": "",
      "title": "Before Stage Digest",
      "type": "string"
    },
    "after_stage_digest": {
      "default": "",
      "title": "After Stage Digest",
      "type": "string"
    },
    "before_artifact_registry_digest": {
      "default": "",
      "title": "Before Artifact Registry Digest",
      "type": "string"
    },
    "after_artifact_registry_digest": {
      "default": "",
      "title": "After Artifact Registry Digest",
      "type": "string"
    },
    "local_dispatch_receipt_ids": {
      "items": {
        "type": "string"
      },
      "title": "Local Dispatch Receipt Ids",
      "type": "array"
    },
    "remote_execution_slot_id": {
      "default": "",
      "title": "Remote Execution Slot Id",
      "type": "string"
    },
    "remote_request_id": {
      "default": "",
      "title": "Remote Request Id",
      "type": "string"
    },
    "remote_request_sha256": {
      "default": "",
      "title": "Remote Request Sha256",
      "type": "string"
    },
    "remote_approval_digest": {
      "default": "",
      "title": "Remote Approval Digest",
      "type": "string"
    },
    "remote_publication_digest": {
      "default": "",
      "title": "Remote Publication Digest",
      "type": "string"
    },
    "gate_snapshot_id": {
      "default": "",
      "title": "Gate Snapshot Id",
      "type": "string"
    },
    "gate_snapshot_hash": {
      "default": "",
      "title": "Gate Snapshot Hash",
      "type": "string"
    },
    "gate_decision_digest": {
      "default": "",
      "title": "Gate Decision Digest",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/AgentHarnessControllerReceiptOutcome"
    },
    "status_after": {
      "$ref": "#/$defs/AgentHarnessControllerStatus"
    },
    "source_bindings": {
      "items": {
        "$ref": "#/$defs/AgentHarnessControllerSourceBinding"
      },
      "title": "Source Bindings",
      "type": "array"
    },
    "source_bindings_digest": {
      "title": "Source Bindings Digest",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "receipt_digest": {
      "default": "",
      "title": "Receipt Digest",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "controller_execution_id",
    "controller_execution_digest",
    "decision_id",
    "decision_digest",
    "action_kind",
    "execution_started",
    "dispatch_occurred",
    "outcome",
    "status_after",
    "source_bindings",
    "source_bindings_digest",
    "reason_codes",
    "created_at"
  ],
  "title": "AgentHarnessControllerActionReceipt",
  "type": "object"
}