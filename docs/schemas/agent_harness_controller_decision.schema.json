{
  "$defs": {
    "AgentHarnessAuthorityClass": {
      "enum": [
        "authoritative",
        "derived",
        "observational",
        "unverified"
      ],
      "title": "AgentHarnessAuthorityClass",
      "type": "string"
    },
    "AgentHarnessControllerAction": {
      "enum": [
        "prepare_local_gate",
        "wait_for_gate",
        "stop_gate_rejected",
        "execute_local_task",
        "adopt_completed_task",
        "prepare_remote_request",
        "wait_for_remote_approval",
        "stop_remote_rejected",
        "dispatch_remote_task",
        "refresh_remote_task",
        "recover_remote_task",
        "adopt_remote_outputs",
        "stop_task_terminal",
        "cancel_execution",
        "complete_execution"
      ],
      "title": "AgentHarnessControllerAction",
      "type": "string"
    },
    "AgentHarnessControllerSourceBinding": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "authority_class": {
          "$ref": "#/$defs/AgentHarnessAuthorityClass",
          "default": "authoritative"
        }
      },
      "required": [
        "name",
        "source_id",
        "source_digest"
      ],
      "title": "AgentHarnessControllerSourceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable deterministic selection of one bounded Controller action.",
  "properties": {
    "schema_version": {
      "const": "agent_harness_controller_decision.v1",
      "default": "agent_harness_controller_decision.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "decision_id": {
      "default": "",
      "title": "Decision Id",
      "type": "string"
    },
    "controller_execution_id": {
      "title": "Controller Execution Id",
      "type": "string"
    },
    "controller_execution_digest": {
      "title": "Controller Execution Digest",
      "type": "string"
    },
    "client_request_id": {
      "title": "Client Request Id",
      "type": "string"
    },
    "inspection_digest": {
      "title": "Inspection Digest",
      "type": "string"
    },
    "action_kind": {
      "$ref": "#/$defs/AgentHarnessControllerAction"
    },
    "task_id": {
      "default": "",
      "title": "Task Id",
      "type": "string"
    },
    "task_index": {
      "anyOf": [
        {
          "maximum": 1023,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Index"
    },
    "attempt_ordinal": {
      "default": 0,
      "maximum": 1023,
      "minimum": 0,
      "title": "Attempt Ordinal",
      "type": "integer"
    },
    "slot_id": {
      "default": "",
      "title": "Slot Id",
      "type": "string"
    },
    "source_bindings": {
      "items": {
        "$ref": "#/$defs/AgentHarnessControllerSourceBinding"
      },
      "title": "Source Bindings",
      "type": "array"
    },
    "source_bindings_digest": {
      "title": "Source Bindings Digest",
      "type": "string"
    },
    "predecessor_receipt_id": {
      "default": "",
      "title": "Predecessor Receipt Id",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "decision_digest": {
      "default": "",
      "title": "Decision Digest",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "executable": {
      "title": "Executable",
      "type": "boolean"
    }
  },
  "required": [
    "controller_execution_id",
    "controller_execution_digest",
    "client_request_id",
    "inspection_digest",
    "action_kind",
    "source_bindings",
    "source_bindings_digest",
    "reason_codes",
    "created_at",
    "executable"
  ],
  "title": "AgentHarnessControllerDecision",
  "type": "object"
}
