{
  "$defs": {
    "AgentHarnessAuthorityClass": {
      "enum": [
        "authoritative",
        "derived",
        "observational",
        "unverified"
      ],
      "title": "AgentHarnessAuthorityClass",
      "type": "string"
    },
    "AgentHarnessControllerSourceBinding": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "authority_class": {
          "$ref": "#/$defs/AgentHarnessAuthorityClass",
          "default": "authoritative"
        }
      },
      "required": [
        "name",
        "source_id",
        "source_digest"
      ],
      "title": "AgentHarnessControllerSourceBinding",
      "type": "object"
    },
    "AgentHarnessControllerTaskSlot": {
      "additionalProperties": false,
      "properties": {
        "planned_task_index": {
          "maximum": 1023,
          "minimum": 0,
          "title": "Planned Task Index",
          "type": "integer"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "attempt": {
          "default": 0,
          "maximum": 1023,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "execution_route": {
          "enum": [
            "local_executor",
            "remote_execution_service"
          ],
          "title": "Execution Route",
          "type": "string"
        },
        "slot_id": {
          "title": "Slot Id",
          "type": "string"
        },
        "task_authority_digest": {
          "title": "Task Authority Digest",
          "type": "string"
        },
        "dispatch_intent_digest": {
          "title": "Dispatch Intent Digest",
          "type": "string"
        },
