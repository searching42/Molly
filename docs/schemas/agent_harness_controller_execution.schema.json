        "input_artifacts_digest": {
          "title": "Input Artifacts Digest",
          "type": "string"
        },
        "output_contract_digest": {
          "title": "Output Contract Digest",
          "type": "string"
        },
        "remote_authority_id": {
          "default": "",
          "title": "Remote Authority Id",
          "type": "string"
        },
        "remote_authority_digest": {
          "default": "",
          "title": "Remote Authority Digest",
          "type": "string"
        }
