      "required": [
        "planned_task_index",
        "task_id",
        "execution_route",
        "slot_id",
        "task_authority_digest",
        "dispatch_intent_digest",
        "compiled_options_digest",
        "input_artifacts_digest",
        "output_contract_digest"
      ],
      "title": "AgentHarnessControllerTaskSlot",
      "type": "object"
    }
