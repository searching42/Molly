{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "structured_dataset_canary_evidence.v1",
  "title": "Structured Dataset Canary Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "project_id", "test_mode", "bindings",
    "source_roster_digest", "replay_digest", "registry_digest",
    "recovery_findings", "privacy_findings", "authority_isolation", "seed",
    "claim_boundary", "private_real_tool_completed", "created_at", "evidence_digest"
  ],
  "properties": {
    "schema_version": {"const": "structured_dataset_canary_evidence.v1"},
    "run_id": {"type": "string"},
    "project_id": {"type": "string"},
    "test_mode": {"enum": ["ci_reference", "private_real_tool"]},
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "object_digest"],
        "properties": {
          "object_id": {"type": "string"},
          "object_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "source_roster_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "replay_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recovery_findings": {"type": "object"},
    "privacy_findings": {"type": "object"},
    "authority_isolation": {"const": "telemetry_non_authoritative_fail_open"},
    "seed": {"type": "integer", "minimum": 0},
    "claim_boundary": {"const": "Computational Top-N only"},
    "private_real_tool_completed": {"type": "boolean"},
    "created_at": {"type": "string"},
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
