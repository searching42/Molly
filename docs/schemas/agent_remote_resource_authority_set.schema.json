{
  "$defs": {
    "AgentConfiguredRemoteResources": {
      "additionalProperties": false,
      "description": "Complete server-configured resources; no nullable/default dimensions.",
      "properties": {
        "gpu_count": {
          "title": "Gpu Count",
          "type": "integer"
        },
        "cpu_threads": {
          "title": "Cpu Threads",
          "type": "integer"
        },
        "walltime_sec": {
          "title": "Walltime Sec",
          "type": "integer"
        }
      },
      "required": [
        "gpu_count",
        "cpu_threads",
        "walltime_sec"
      ],
      "title": "AgentConfiguredRemoteResources",
      "type": "object"
    },
    "AgentRemoteResourceAggregateBudget": {
      "additionalProperties": false,
      "description": "Versioned conservative plan-level aggregation over the remote roster.",
      "properties": {
        "schema_version": {
          "const": "agent_remote_resource_aggregate_budget.v1",
          "default": "agent_remote_resource_aggregate_budget.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "remote_task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Remote Task Ids",
          "type": "array"
        },
        "per_task_budget_bindings": {
          "items": {
            "$ref": "#/$defs/AgentRemoteResourceTaskBudgetBinding"
          },
          "title": "Per Task Budget Bindings",
          "type": "array"
        },
        "walltime_aggregation_policy": {
          "const": "sequential_sum.v1",
          "default": "sequential_sum.v1",
          "title": "Walltime Aggregation Policy",
          "type": "string"
        },
        "total_derived_gpu_hours": {
          "title": "Total Derived Gpu Hours",
          "type": "number"
        },
        "total_configured_cpu_threads": {
          "title": "Total Configured Cpu Threads",
          "type": "integer"
        },
        "total_walltime_upper_bound_sec": {
          "title": "Total Walltime Upper Bound Sec",
          "type": "integer"
        },
        "plan_max_runtime_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Max Runtime Sec"
        },
        "plan_max_gpu_hours": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Max Gpu Hours"
        },
        "plan_max_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Max Cost Usd"
        },
        "aggregate_budget_digest": {
          "default": "",
          "title": "Aggregate Budget Digest",
          "type": "string"
        }
      },
      "required": [
        "remote_task_ids",
        "per_task_budget_bindings",
        "total_derived_gpu_hours",
        "total_configured_cpu_threads",
        "total_walltime_upper_bound_sec"
      ],
      "title": "AgentRemoteResourceAggregateBudget",
      "type": "object"
    },
    "AgentRemoteResourceBudgetLimits": {
      "additionalProperties": false,
      "properties": {
        "max_runtime_sec": {
          "title": "Max Runtime Sec",
          "type": "integer"
        },
        "max_gpu_hours": {
          "title": "Max Gpu Hours",
          "type": "number"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        }
      },
      "required": [
        "max_runtime_sec",
        "max_gpu_hours"
      ],
      "title": "AgentRemoteResourceBudgetLimits",
      "type": "object"
    },
    "AgentRemoteResourceTaskBudgetBinding": {
      "additionalProperties": false,
      "description": "Exact resource and budget material for one remote task in a set.",
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "authority_id": {
          "title": "Authority Id",
          "type": "string"
        },
        "authority_digest": {
          "title": "Authority Digest",
          "type": "string"
        },
        "configured_resources": {
          "$ref": "#/$defs/AgentConfiguredRemoteResources"
        },
        "budget_limits": {
          "$ref": "#/$defs/AgentRemoteResourceBudgetLimits"
        },
        "budget_policy_digest": {
          "title": "Budget Policy Digest",
          "type": "string"
        },
        "derived_gpu_hours": {
          "title": "Derived Gpu Hours",
          "type": "number"
        }
      },
      "required": [
        "task_id",
        "authority_id",
        "authority_digest",
        "configured_resources",
        "budget_limits",
        "budget_policy_digest",
        "derived_gpu_hours"
      ],
      "title": "AgentRemoteResourceTaskBudgetBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Manifest-last activation boundary for one complete remote task roster.",
  "properties": {
    "schema_version": {
      "const": "agent_remote_resource_authority_set.v1",
      "default": "agent_remote_resource_authority_set.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "authority_set_id": {
      "default": "",
      "title": "Authority Set Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_digest": {
      "title": "Proposal Digest",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "decision_digest": {
      "title": "Decision Digest",
      "type": "string"
    },
    "ordered_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Ordered Task Ids",
      "type": "array"
    },
    "remote_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Remote Task Ids",
      "type": "array"
    },
    "authority_bindings": {
      "items": {
        "$ref": "#/$defs/AgentRemoteResourceTaskBudgetBinding"
      },
      "title": "Authority Bindings",
      "type": "array"
    },
    "complete_roster_digest": {
      "title": "Complete Roster Digest",
      "type": "string"
    },
    "aggregate_budget": {
      "$ref": "#/$defs/AgentRemoteResourceAggregateBudget"
    },
    "aggregate_budget_digest": {
      "title": "Aggregate Budget Digest",
      "type": "string"
    },
    "authority_set_digest": {
      "default": "",
      "title": "Authority Set Digest",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "executable": {
      "const": false,
      "default": false,
      "title": "Executable",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "run_id",
    "proposal_id",
    "proposal_digest",
    "decision_id",
    "decision_digest",
    "ordered_task_ids",
    "remote_task_ids",
    "authority_bindings",
    "complete_roster_digest",
    "aggregate_budget",
    "aggregate_budget_digest",
    "created_at"
  ],
  "title": "AgentRemoteResourceAuthoritySet",
  "type": "object"
}
