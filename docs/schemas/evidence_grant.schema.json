    "schema_version": {
      "const": "evidence_grant.v1",
      "default": "evidence_grant.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "grant_id": {
      "default": "",
      "title": "Grant Id",
      "type": "string"
    },
    "grant_digest": {
      "default": "",
      "title": "Grant Digest",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_digest": {
      "title": "Source Digest",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/EvidenceGrantScope"
    },
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "actor_source": {
      "title": "Actor Source",
      "type": "string"
    },
    "issuer": {
      "const": "server",
      "default": "server",
      "title": "Issuer",
      "type": "string"
    },
    "issued_at": {
      "title": "Issued At",
      "type": "string"
    },
