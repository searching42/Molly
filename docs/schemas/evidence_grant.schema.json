{
  "$defs": {
    "EvidenceGrantScope": {
      "description": "Closed-world evidence scopes supported by the current Agent paths.",
      "enum": [
        "extracted_dataset_confirmation",
        "extracted_dataset_confirmation",
        "extracted_dataset_confirmation"
      ],
      "title": "EvidenceGrantScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable server-issued authority for one exact evidence source.\n\nThis is deliberately not an execution or retry permission.  The one v1\nscope is exact-source only; omitting item IDs is not a wildcard because\n``coverage_mode`` is a closed, explicit ``exact_source`` value.",
