      "default": "exact_source",
      "title": "Coverage Mode",
      "type": "string"
    },
    "evidence_item_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Item Ids",
      "type": "array"
    },
    "evidence_item_digests": {
