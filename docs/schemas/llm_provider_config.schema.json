{
  "$defs": {
    "LLMProviderCapabilities": {
      "description": "Explicit server-owned capabilities for one configured LLM profile.",
      "properties": {
        "structured_output_mode": {
          "default": "native_json_schema",
          "enum": [
            "native_json_schema",
            "json_object_local_validation"
          ],
          "title": "Structured Output Mode",
          "type": "string"
        },
        "control_plane_eligible": {
          "default": true,
          "title": "Control Plane Eligible",
          "type": "boolean"
        },
        "scientific_mapping_eligible": {
          "default": true,
          "title": "Scientific Mapping Eligible",
          "type": "boolean"
        }
      },
      "title": "LLMProviderCapabilities",
      "type": "object"
    }
  },
  "properties": {
    "provider": {
      "default": "stub",
      "title": "Provider",
      "type": "string"
    },
    "endpoint": {
      "default": "",
      "title": "Endpoint",
      "type": "string"
    },
    "api_key": {
      "default": "",
      "title": "Api Key",
      "type": "string"
    },
    "model": {
      "default": "",
      "title": "Model",
      "type": "string"
    },
    "timeout_sec": {
      "default": 60,
      "title": "Timeout Sec",
      "type": "integer"
    },
    "connect_timeout_sec": {
      "default": 10.0,
      "title": "Connect Timeout Sec",
      "type": "number"
    },
    "write_timeout_sec": {
      "default": 30.0,
      "title": "Write Timeout Sec",
      "type": "number"
    },
    "pool_timeout_sec": {
      "default": 10.0,
      "title": "Pool Timeout Sec",
      "type": "number"
    },
    "total_timeout_sec": {
      "default": 300.0,
      "title": "Total Timeout Sec",
      "type": "number"
    },
    "max_connect_retries": {
      "default": 1,
      "title": "Max Connect Retries",
      "type": "integer"
    },
    "retry_backoff_sec": {
      "default": 0.25,
      "title": "Retry Backoff Sec",
      "type": "number"
    },
    "structured_output_transport": {
      "default": "buffered",
      "enum": [
        "buffered",
        "sse_stream"
      ],
      "title": "Structured Output Transport",
      "type": "string"
    },
    "stub_response": {
      "additionalProperties": true,
      "title": "Stub Response",
      "type": "object"
    },
    "capabilities": {
      "$ref": "#/$defs/LLMProviderCapabilities"
    }
  },
  "title": "LLMProviderConfig",
  "type": "object"
}
