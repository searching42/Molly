{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molly.local/schemas/br1_unimol_applicability_report.schema.json",
  "title": "BR1 Uni-Mol Applicability Report v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "oneOf": [
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        {"const": "unavailable"}
      ]
    },
    "reason": {"type": "string", "enum": [
      "INVALID_SMILES",
      "NONFINITE_TARGET",
      "TARGET_OUT_OF_RANGE",
      "MULTICOMPONENT_MOLECULE",
      "FORMAL_CHARGE_UNSUPPORTED",
      "UNSUPPORTED_ELEMENT",
      "ATOM_COUNT_LIMIT_EXCEEDED",
      "CONFORMER_GENERATION_FAILED",
      "UNIMOL_PREPROCESS_FAILED",
      "PROVIDER_VERSION_UNAVAILABLE",
      "PROVIDER_VERSION_MISMATCH",
      "PROVIDER_VERSION_AUTHORITY_UNAVAILABLE",
      "PROVIDER_PREFLIGHT_API_UNAVAILABLE",
      "INPUT_DIGEST_MISMATCH",
      "SOURCE_AUTHORITY_INVALID",
      "MAPPING_POLICY_INVALID",
      "RAW_DATASET_CONTRACT_INVALID",
      "ROW_ID_INVALID",
      "PROVIDER_CAPABILITY_UNAVAILABLE",
      "PROVIDER_ADAPTER_CONTRACT_UNAVAILABLE",
      "PROVIDER_PREPROCESS_NOT_RUN",
      "CONFORMER_PREPROCESS_NOT_RUN",
      "WORKER_IMPLEMENTATION_UNAVAILABLE",
      "EXECUTION_PROFILE_UNAVAILABLE",
      "SOURCE_PUBLICATION_REGISTRY_INVALID",
      "CANONICAL_INPUT_INVALID"
    ]},
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_algorithm",
        "canonicalization_contract_version",
        "source_artifact_id",
        "source_publication_registry_id",
        "source_publication_registry_digest",
        "source_publication_digest",
        "expected_raw_dataset_digest",
        "observed_raw_dataset_digest",
        "expected_canonical_source_dataset_digest",
        "observed_canonical_source_dataset_digest",
        "expected_canonical_provider_input_digest",
        "observed_canonical_provider_input_digest",
        "staged_provider_input_digest",
        "provider_actual_input_digest",
        "source_dataset_manifest_digest",
        "mapping_policy_digest",
        "mapping_binding_digest",
        "input_row_count"
      ],
      "properties": {
        "digest_algorithm": {"const": "sha256"},
        "canonicalization_contract_version": {"type": "string", "minLength": 1},
        "source_artifact_id": {"type": "string", "minLength": 1},
        "source_publication_registry_id": {"oneOf": [{"type": "string", "pattern": "^(?!unavailable$)[a-z0-9][a-z0-9_.-]{0,95}$"}, {"const": "unavailable"}]},
        "source_publication_registry_digest": {"$ref": "#/$defs/digest"},
        "source_publication_digest": {"$ref": "#/$defs/digest"},
        "expected_raw_dataset_digest": {"$ref": "#/$defs/digest"},
        "observed_raw_dataset_digest": {"$ref": "#/$defs/digest"},
        "expected_canonical_source_dataset_digest": {"$ref": "#/$defs/digest"},
        "observed_canonical_source_dataset_digest": {"$ref": "#/$defs/digest"},
        "expected_canonical_provider_input_digest": {"$ref": "#/$defs/digest"},
        "observed_canonical_provider_input_digest": {"$ref": "#/$defs/digest"},
        "staged_provider_input_digest": {"$ref": "#/$defs/digest"},
        "provider_actual_input_digest": {"$ref": "#/$defs/digest"},
        "source_dataset_manifest_digest": {"$ref": "#/$defs/digest"},
        "mapping_policy_digest": {"$ref": "#/$defs/digest"},
        "mapping_binding_digest": {"$ref": "#/$defs/digest"},
        "input_row_count": {"type": "integer", "minimum": 0}
      }
    },
    "capability_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_contract_version",
        "provider_name",
        "provider_version",
        "compatible_execution_profiles",
        "molecule_representations",
        "required_fields",
        "optional_fields",
        "target_field",
        "row_identity_field",
        "condition_context_fields",
        "missing_value_policy",
        "filter_policy",
        "duplicate_row_policy",
        "canonical_row_order",
        "output_columns",
        "applicability_preflight_available",
        "training_dispatched",
        "generation_dispatched",
        "prediction_dispatched",
        "ranking_dispatched"
      ],
      "properties": {
        "adapter_contract_version": {"const": "br1_unimol_provider_adapter.v1"},
        "provider_name": {"const": "unimol-tools"},
        "provider_version": {"type": "string", "minLength": 1},
        "compatible_execution_profiles": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "molecule_representations": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "optional_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "target_field": {"type": "string", "minLength": 1},
        "row_identity_field": {"type": "string", "minLength": 1},
        "condition_context_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "missing_value_policy": {"type": "string", "minLength": 1},
        "filter_policy": {"type": "string", "minLength": 1},
        "duplicate_row_policy": {"type": "string", "minLength": 1},
        "canonical_row_order": {"type": "string", "minLength": 1},
        "output_columns": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "applicability_preflight_available": {"const": true},
        "training_dispatched": {"const": false},
        "generation_dispatched": {"const": false},
        "prediction_dispatched": {"const": false},
        "ranking_dispatched": {"const": false}
      }
    },
    "dispatch_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_capability_probe_dispatched",
        "provider_preprocessing_dispatched",
        "training_dispatched",
        "generation_dispatched",
        "prediction_dispatched",
        "ranking_dispatched",
        "model_artifacts_created",
        "scaler_created",
        "training_metrics_created"
      ],
      "properties": {
        "provider_capability_probe_dispatched": {"type": "boolean"},
        "provider_preprocessing_dispatched": {"type": "boolean"},
        "training_dispatched": {"const": false},
        "generation_dispatched": {"const": false},
        "prediction_dispatched": {"const": false},
        "ranking_dispatched": {"const": false},
        "model_artifacts_created": {"const": false},
        "scaler_created": {"const": false},
        "training_metrics_created": {"const": false}
      }
    },
    "row_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "standard_inchikey",
        "canonical_molecule_identity_digest",
        "target_validity",
        "element_roster",
        "atom_count",
        "formal_charge",
        "fragment_count",
        "provider_preprocessing_status",
        "conformer_preprocessing_status",
        "status",
        "reason_codes"
      ],
      "properties": {
        "row_id": {"type": "string"},
        "standard_inchikey": {"type": ["string", "null"]},
        "canonical_molecule_identity_digest": {"oneOf": [{"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, {"type": "null"}]},
        "target_validity": {"enum": ["VALID", "INVALID", "UNRESOLVED"]},
        "element_roster": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "atom_count": {"type": ["integer", "null"], "minimum": 0},
        "formal_charge": {"type": ["integer", "null"]},
        "fragment_count": {"type": ["integer", "null"], "minimum": 0},
        "provider_preprocessing_status": {"enum": ["SUPPORTED", "UNSUPPORTED", "UNRESOLVED", "NOT_RUN", "FAILED"]},
        "conformer_preprocessing_status": {"enum": ["SUPPORTED", "UNSUPPORTED", "UNRESOLVED", "NOT_RUN", "FAILED"]},
        "status": {"enum": ["SUPPORTED", "UNSUPPORTED", "UNRESOLVED"]},
        "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/reason"}, "uniqueItems": true}
      }
    }
  },
  "required": [
    "schema_version",
    "raw_dataset_digest",
    "source_dataset_manifest_digest",
    "mapping_policy_digest",
    "source_authority_digest",
    "source_publication_registry_digest",
    "source_publication_digest",
    "mapping_policy_version",
    "mapping_binding_digest",
    "canonicalization_contract_version",
    "input_identity",
    "repository_commit",
    "worker_implementation_digest",
    "execution_profile_id",
    "execution_profile_digest",
    "provider_name",
    "provider_version",
    "expected_provider_version",
    "provider_capabilities_digest",
    "provider_capability_contract",
    "provider_capability_contract_version",
    "provider_capability_contract_digest",
    "dispatch_assertions",
    "applicability_policy_version",
    "applicability_policy_digest",
    "input_row_count",
    "supported_row_count",
    "unsupported_row_count",
    "unresolved_row_count",
    "supported_row_roster_digest",
    "unsupported_row_roster_digest",
    "unresolved_row_roster_digest",
    "reason_counts",
    "global_reason_codes",
    "authority_verification_status",
    "overall_status",
    "row_results",
    "created_at",
    "claim_boundary",
    "report_digest"
  ],
  "properties": {
    "schema_version": {"const": "br1_unimol_applicability_report.v1"},
    "raw_dataset_digest": {"$ref": "#/$defs/digest"},
    "source_dataset_manifest_digest": {"$ref": "#/$defs/digest"},
    "mapping_policy_digest": {"$ref": "#/$defs/digest"},
    "source_authority_digest": {"$ref": "#/$defs/digest"},
    "source_publication_registry_digest": {"$ref": "#/$defs/digest"},
    "source_publication_digest": {"$ref": "#/$defs/digest"},
    "mapping_policy_version": {"type": "string", "minLength": 1},
    "mapping_binding_digest": {"$ref": "#/$defs/digest"},
    "canonicalization_contract_version": {"type": "string", "minLength": 1},
    "input_identity": {"$ref": "#/$defs/input_identity"},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worker_implementation_digest": {"$ref": "#/$defs/digest"},
    "execution_profile_id": {"type": "string", "minLength": 1},
    "execution_profile_digest": {"$ref": "#/$defs/digest"},
    "provider_name": {"type": "string", "minLength": 1},
    "provider_version": {"type": "string", "minLength": 1},
    "expected_provider_version": {
      "oneOf": [
        {"type": "string", "pattern": "^(?!unavailable$)[A-Za-z0-9][A-Za-z0-9._+~:-]{0,63}$"},
        {"const": "unavailable"}
      ]
    },
    "provider_capabilities_digest": {"$ref": "#/$defs/digest"},
    "provider_capability_contract": {"oneOf": [{"$ref": "#/$defs/capability_contract"}, {"type": "null"}]},
    "provider_capability_contract_version": {"oneOf": [{"type": "string", "pattern": "^(?!unavailable$).+"}, {"const": "unavailable"}]},
    "provider_capability_contract_digest": {"$ref": "#/$defs/digest"},
    "dispatch_assertions": {"$ref": "#/$defs/dispatch_assertions"},
    "applicability_policy_version": {"const": "br1_unimol_applicability_policy.v1"},
    "applicability_policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_row_count": {"type": "integer", "minimum": 0},
    "supported_row_count": {"type": "integer", "minimum": 0},
    "unsupported_row_count": {"type": "integer", "minimum": 0},
    "unresolved_row_count": {"type": "integer", "minimum": 0},
    "supported_row_roster_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "unsupported_row_roster_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "unresolved_row_roster_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reason_counts": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^[A-Z0-9_]+$": {"type": "integer", "minimum": 1}}
    },
    "global_reason_codes": {"type": "array", "items": {"$ref": "#/$defs/reason"}, "uniqueItems": true},
    "authority_verification_status": {"enum": ["VERIFIED", "INVALID", "UNRESOLVED"]},
    "overall_status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]},
    "row_results": {"type": "array", "items": {"$ref": "#/$defs/row_result"}},
    "created_at": {"type": "string", "format": "date-time"},
    "claim_boundary": {"const": "Applicability preflight only; no training, generation, prediction, acceptance, or scientific validity is claimed."},
    "report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
