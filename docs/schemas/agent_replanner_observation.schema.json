        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "source_kind": {
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "name",
        "source_id",
        "source_digest",
        "source_kind"
