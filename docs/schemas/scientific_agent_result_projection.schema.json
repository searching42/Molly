{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molly.local/schemas/scientific_agent_result_projection.schema.json",
  "title": "Scientific Agent Result Projection v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_sha256", "artifact_id", "size_bytes"],
      "properties": {
        "publication_sha256": {"$ref": "#/$defs/digest"},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "ranked_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "candidate_id", "score", "score_label"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
        "score": {"type": "number"},
        "score_label": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
        "smiles": {"type": ["string", "null"], "maxLength": 512},
        "canonical_smiles": {"type": ["string", "null"], "maxLength": 512},
        "predicted_property": {"type": ["number", "null"]},
        "ad_ood_status": {"type": ["string", "null"], "maxLength": 128},
        "nearest_neighbor_similarity": {"type": ["number", "null"]},
        "scaffold_novelty": {"type": ["string", "null"], "maxLength": 128},
        "validation_findings": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "maxLength": 128}
        },
        "model_binding": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "generation_binding": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "ranking_binding": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "provenance_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "summary_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "ranked_candidate_count",
        "top_n",
        "score_field",
        "score_direction"
      ],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "ranked_candidate_count": {"type": "integer", "minimum": 0},
        "top_n": {"type": "integer", "minimum": 1},
        "score_field": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
        "score_direction": {"const": "descending"},
        "best_score": {"type": ["number", "null"]},
        "worst_score": {"type": ["number", "null"]}
      }
    }
  },
  "required": [
    "schema_version",
    "projection_id",
    "projection_digest",
    "project_id",
    "run_id",
    "source_publication_sha256",
    "artifact_registry_digest",
    "task_type",
    "output_contract",
    "verification_status",
    "source_artifacts",
    "artifact_digests",
    "summary_statistics",
    "ranked_candidates",
    "scientific_limitations"
  ],
  "properties": {
    "schema_version": {"const": "scientific_agent_result_projection.v1"},
    "projection_id": {"$ref": "#/$defs/identifier"},
    "projection_digest": {"$ref": "#/$defs/digest"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_publication_sha256": {"$ref": "#/$defs/digest"},
    "artifact_registry_digest": {"$ref": "#/$defs/digest"},
    "task_type": {
      "enum": [
        "predict_private_unimol_v1",
        "generate_private_reinvent4_v1",
        "evaluate_private_structured_dataset_canary_v1"
      ]
    },
    "output_contract": {
      "enum": [
        "unimol-prediction-output-v1",
        "reinvent4-generation-output-v1",
        "reinvent4-generation-output-v2",
        "computational-top-n-v1"
      ]
    },
    "verification_status": {"const": "verified"},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_artifact"}
    },
    "artifact_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "summary_statistics": {"$ref": "#/$defs/summary_statistics"},
    "ranked_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/ranked_candidate"}
    },
    "scientific_limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    }
  }
}
