{
  "$defs": {
    "ScientificToolSpec": {
      "additionalProperties": false,
      "description": "Strict, LLM-facing projection of one registered atomic task.",
      "properties": {
        "schema_version": {
          "const": "scientific_tool_spec.v1",
          "default": "scientific_tool_spec.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "input_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Input Artifact Ids",
          "type": "array"
        },
        "output_artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Output Artifact Ids",
          "type": "array"
        },
        "effect_class": {
          "enum": [
            "observe",
            "derive_local",
            "mutate_artifacts",
            "external_io",
            "compute",
            "scientific_confirm",
            "change_objective",
            "publish_or_promote"
          ],
          "title": "Effect Class",
          "type": "string"
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "required_permissions": {
          "items": {
            "type": "string"
          },
          "title": "Required Permissions",
          "type": "array"
        },
        "required_gates": {
          "items": {
            "type": "string"
          },
          "title": "Required Gates",
          "type": "array"
        },
        "option_schema": {
          "additionalProperties": true,
          "title": "Option Schema",
          "type": "object"
        },
        "logical_profile_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Logical Profile Requirements",
          "type": "array"
        },
        "budget_dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Budget Dimensions",
          "type": "array"
        },
        "supports_plan_preapproval": {
          "default": false,
          "title": "Supports Plan Preapproval",
          "type": "boolean"
        },
        "idempotency_policy": {
          "default": "server_checked",
          "enum": [
            "none",
            "replay_safe",
            "server_checked"
          ],
          "title": "Idempotency Policy",
          "type": "string"
        },
        "verification_policy": {
          "title": "Verification Policy",
          "type": "string"
        },
        "planner_visible": {
          "default": true,
          "title": "Planner Visible",
          "type": "boolean"
        }
      },
      "required": [
        "tool_id",
        "task_id",
        "label",
        "description",
        "effect_class",
        "risk_level",
        "verification_policy"
      ],
      "title": "ScientificToolSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic catalog projection; never an execution registry.",
  "properties": {
    "schema_version": {
      "const": "scientific_tool_catalog.v1",
      "default": "scientific_tool_catalog.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "catalog_id": {
      "default": "scientific-tool-catalog-v1",
      "title": "Catalog Id",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ScientificToolSpec"
      },
      "title": "Tools",
      "type": "array"
    },
    "excluded_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Task Ids",
      "type": "array"
    },
    "catalog_digest": {
      "default": "",
      "title": "Catalog Digest",
      "type": "string"
    }
  },
  "title": "ScientificToolCatalog",
  "type": "object"
}